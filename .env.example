# Copy to .env (never commit). On macOS the packaged app reads these from the Keychain instead.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Non-secret tuning
JAM_AGENT_MODEL=claude-opus-5-5
JAM_FAST_MODEL=claude-haiku-5-5
JAM_TTS_MODEL=sonic-3.5
JAM_TTS_VOICE_ID=
JAM_STT_MODEL=flux-general-en
