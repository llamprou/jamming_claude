{
  "name": "jamming-claude",
  "version": "0.1.0",
  "private": true,
  "description": "A live, Claude-powered music jamming buddy for macOS.",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs && (node scripts/fetch-samples.mjs || echo \"Instrument samples were not fetched; the app will use synthesized stand-ins. Run npm run samples to retry.\")",
    "samples": "node scripts/fetch-samples.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:sampler": "node scripts/smoke-sampler.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@anthropic-ai/sdk": "^1.12.0",
    "@cartesia/cartesia-js": "^5.2.0",
    "@deepgram/sdk": "^5.20.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tonal": "^6.8.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
